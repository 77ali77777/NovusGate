table inet novusgate
delete table inet novusgate
table inet novusgate {
	set ssh_ports {
		type inet_service
		elements = { 22 }
	}
	set wg_ports {
		type inet_service
		flags interval
		elements = { 51820-51900 }
	}
	set blocked_v4 {
		type ipv4_addr
		flags interval, timeout
	}
	set blocked_v6 {
		type ipv6_addr
		flags interval, timeout
		elements = { 2001:db8:2::/48 timeout 3600s }
	}
	set egress_v4 {
		type ipv4_addr
	}
	set dropped_v4 {
		type ipv4_addr
		size 4096
		flags dynamic, timeout
		timeout 1h
	}
	set dropped_v6 {
		type ipv6_addr
		size 4096
		flags dynamic, timeout
		timeout 1h
	}
	chain input {
		type filter hook input priority filter - 10; policy drop;
		iif "lo" accept
		ip saddr @blocked_v4 counter drop
		ip6 saddr @blocked_v6 counter drop
		ip saddr 192.0.2.0/24 tcp dport { 22 } counter drop comment "ip:no-ssh-from-lab"
		ct state established,related accept
		ct state invalid drop
		tcp dport @ssh_ports accept
		udp dport @wg_ports accept
		ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept comment "dhcpv6 client"
		iifname "wg0" tcp dport { 3007, 5432 } accept
		iifname { "wg0", "wg1" } tcp dport { 8080, 8443 } accept
		iifname { "wg0", "wg1" } meta l4proto { tcp, udp } th dport 53 accept comment "hub dns"
		tcp dport { 3007, 5432, 8080, 8443 } counter drop comment "admin ports: VPN only"
		ip6 saddr 2001:db8:1::/48 udp dport { 1194 } accept comment "ip:vpn-udp-v6"
		meta l4proto { icmp, ipv6-icmp } accept
		update @dropped_v4 { ip saddr }
		update @dropped_v6 { ip6 saddr }
		counter comment "default drop"
	}
	chain forward {
		type filter hook forward priority filter - 10; policy accept;
		ip saddr @blocked_v4 counter drop
		ip6 saddr @blocked_v6 counter drop
		ct state established,related accept
		iifname "wg0" meta l4proto tcp ct original proto-dst 5432 ct status dnat accept comment "admin VPN to docker-published postgres"
		meta l4proto tcp ct original proto-dst 5432 ct status dnat counter drop comment "docker-published postgres"
		iifname "wg*" jump vpn_policy
		oifname "wg*" ct status dnat accept
		oifname "wg*" counter drop
	}
	chain vpn_policy {
		ip saddr 10.20.0.0/24 tcp dport { 445 } counter reject comment "rule:reject-smb"
		iifname "wg1" oifname "wg1" accept
		oifname "eth0" ip saddr @egress_v4 accept
		counter drop comment "vpn default drop"
	}
	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		iifname "eth0" udp dport 27015 dnat ip to 10.20.0.9:27015 comment "fwd:game"
	}
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		ip daddr 10.20.0.9 oifname "wg1" udp dport 27015 ct status dnat masquerade comment "fwd:game"
		oifname "eth0" ip saddr @egress_v4 masquerade
	}
}
