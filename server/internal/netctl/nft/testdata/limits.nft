table inet novusgate
delete table inet novusgate
table inet novusgate {
	set ssh_ports {
		type inet_service
		elements = { 22 }
	}
	set wg_ports {
		type inet_service
		flags interval
		elements = { 51820-51900 }
	}
	set blocked_v4 {
		type ipv4_addr
		flags interval, timeout
	}
	set blocked_v6 {
		type ipv6_addr
		flags interval, timeout
	}
	set egress_v4 {
		type ipv4_addr
	}
	set lim_0 {
		type ipv4_addr
		elements = { 10.20.0.5, 10.20.0.6 }
	}
	set lim_0_up {
		type ipv4_addr
		size 65535
		flags dynamic, timeout
		timeout 1m
	}
	set lim_0_down {
		type ipv4_addr
		size 65535
		flags dynamic, timeout
		timeout 1m
	}
	set lim_0_ct {
		type ipv4_addr
		size 65535
		flags dynamic
	}
	set lim_1 {
		type ipv4_addr
		elements = { 10.20.0.9 }
	}
	set lim_1_down {
		type ipv4_addr
		size 65535
		flags dynamic, timeout
		timeout 1m
	}
	set dropped_v4 {
		type ipv4_addr
		size 4096
		flags dynamic, timeout
		timeout 1h
	}
	set dropped_v6 {
		type ipv6_addr
		size 4096
		flags dynamic, timeout
		timeout 1h
	}
	chain input {
		type filter hook input priority filter - 10; policy drop;
		iif "lo" accept
		ip saddr @blocked_v4 counter drop
		ip6 saddr @blocked_v6 counter drop
		ct state established,related accept
		ct state invalid drop
		tcp dport @ssh_ports accept
		udp dport @wg_ports accept
		ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept comment "dhcpv6 client"
		iifname "wg0" tcp dport { 3007, 5432 } accept
		iifname { "wg0", "wg1" } tcp dport { 8080, 8443 } accept
		tcp dport { 3007, 5432, 8080, 8443 } counter drop comment "admin ports: VPN only"
		meta l4proto { icmp, ipv6-icmp } accept
		update @dropped_v4 { ip saddr }
		update @dropped_v6 { ip6 saddr }
		counter comment "default drop"
	}
	chain forward {
		type filter hook forward priority filter - 10; policy accept;
		ip saddr @blocked_v4 counter drop
		ip6 saddr @blocked_v6 counter drop
		jump limits
		ct state established,related accept
		iifname "wg0" meta l4proto tcp ct original proto-dst 5432 ct status dnat accept comment "admin VPN to docker-published postgres"
		meta l4proto tcp ct original proto-dst 5432 ct status dnat counter drop comment "docker-published postgres"
		iifname "wg*" jump vpn_policy
		oifname "wg*" ct status dnat accept
		oifname "wg*" counter drop
	}
	chain vpn_policy {
		iifname "wg1" oifname "wg1" accept
		oifname "eth0" ip saddr @egress_v4 accept
		counter drop comment "vpn default drop"
	}
	chain limits {
		ip saddr @lim_0 jump lim_0_time
		ip daddr @lim_0 jump lim_0_time
		ip saddr @lim_0 update @lim_0_up { ip saddr limit rate over 125000 bytes/second burst 125000 bytes } counter drop comment "limit:office:up"
		ip daddr @lim_0 update @lim_0_down { ip daddr limit rate over 250000 bytes/second burst 250000 bytes } counter drop comment "limit:office:down"
		ct state new ip saddr @lim_0 add @lim_0_ct { ip saddr ct count over 50 } counter drop comment "limit:office:conn"
		ip daddr @lim_1 update @lim_1_down { ip daddr limit rate over 62500 bytes/second burst 62500 bytes } counter drop comment "limit:guests:down"
	}
	chain lim_0_time {
		meta day "Sunday" meta hour "22:00:00"-"23:59:59" return
		meta day "Monday" meta hour "04:00:00"-"13:59:59" return
		counter drop comment "limit:office:schedule"
	}
	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
	}
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "eth0" ip saddr @egress_v4 masquerade
	}
}
