# NovusGate server configuration — copy to .env in this directory:
#   cp .env.example .env && chmod 600 .env
# Then replace every CHANGE_ME value. docker compose reads this file.
#
# Value rules (docker compose interpolates "$" and treats quotes, spaces and
# "#" specially; DB values also go into a postgres:// URL):
#   - no spaces, quotes, $, #, backslashes;
#   - DB_USER, DB_PASSWORD, DB_NAME and API_KEY: only A-Z a-z 0-9 . _ ~ -
# Generate random values with:  openssl rand -hex 16   (or -hex 32 for MASTER_KEY)

# --- Database (PostgreSQL 16, container "postgres") --------------------------
DB_NAME=novusgate
DB_USER=novusgate
# Required in practice: the default is public. 32 hex characters is fine.
DB_PASSWORD=CHANGE_ME_openssl_rand_hex_16

# --- Panel login ---------------------------------------------------------------
# First user, created only when the users table is empty.
ADMIN_USERNAME=admin
# REQUIRED: compose refuses to start without it.
ADMIN_PASSWORD=CHANGE_ME_strong_password

# --- Secrets -------------------------------------------------------------------
# X-API-Key the control plane requires on every API call; the panel's nginx
# adds it (the browser never sees it). Only A-Z a-z 0-9 . _ ~ -
API_KEY=CHANGE_ME_openssl_rand_hex_16
# Seals node WireGuard private keys in the database (AES-256-GCM).
# Exactly 64 hex characters: openssl rand -hex 32
# Back it up with this file: if it is lost, node configs must be re-created;
# never change it once nodes exist. Empty = keys stored unencrypted (warning).
MASTER_KEY=CHANGE_ME_openssl_rand_hex_32
# Passed to the control plane but not used by it at present; any random value.
JWT_SECRET=CHANGE_ME_openssl_rand_hex_16

# --- Network -------------------------------------------------------------------
# Public IP or DNS name of this server: clients' WireGuard Endpoint.
WG_SERVER_ENDPOINT=CHANGE_ME_public_ip_or_hostname
# Admin VPN (wg0) subnet; the hub takes its first address (e.g. 10.99.0.1).
# REQUIRED by the control plane at first start.
ADMIN_CIDR=10.99.0.0/24

# --- Behaviour -----------------------------------------------------------------
# Host firewall engine: iptables (default, legacy) | shadow (nftables checked,
# not applied) | nft (nftables enforces; see docs/runbooks/p3b2-firewall-cutover.md)
FIREWALL_ENGINE=iptables
# WireGuard reconciler: off | shadow (default: report only) | enforce
WG_RECONCILER=shadow
# Logs: LOG_FORMAT json | text ; LOG_LEVEL debug | info | warn | error
LOG_FORMAT=json
LOG_LEVEL=info
